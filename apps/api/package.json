{
  "name": "@hna/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@hna/shared": "*",
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "express": "^5.2.1",
    "cookie-parser": "^1.4.6",
    "argon2": "^0.45.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "zod": "^4.4.3",
    "@react-pdf/renderer": "^4.5.1",
    "react": "^19.2.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.0.0",
    "@types/react": "^19.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
