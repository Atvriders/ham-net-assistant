{
  "name": "@hna/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ham-Net-Assistant API server — Express 5 + Prisma/SQLite, JWT-in-cookie auth, Discord bridge, and the built SPA.",
  "license": "MIT",
  "author": "Atvriders",
  "homepage": "https://github.com/Atvriders/ham-net-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atvriders/ham-net-assistant.git",
    "directory": "apps/api"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin": "node dist/cli/admin.js",
    "db:snapshot": "node dist/cli/backup.js"
  },
  "dependencies": {
    "@hna/shared": "*",
    "@prisma/client": "^6.0.0",
    "@react-pdf/renderer": "^4.6.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.6",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "prisma": "^6.0.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
