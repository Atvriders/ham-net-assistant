# Ham-Net-Assistant — environment template
#
# Copy to `.env` (repo root) and edit:  cp .env.example .env
#
# WHO READS THIS FILE
#   * `docker compose` reads the repo-root `.env` for ${VAR} substitution in
#     docker-compose.yml. That is the ONLY automatic consumer.
#   * The API process does NOT read any .env file — there is no dotenv
#     dependency in the app. For local dev you must export these vars in the
#     shell that starts the server (see README "Local development").
#   * The Prisma CLI (`prisma migrate …`, `prisma generate`) DOES read a .env
#     from its working directory, which is why `apps/api/.env` can make
#     migrations work while the server still fails — don't be fooled by it.
#
# Only the variables listed in docker-compose.yml's `environment:` block reach
# the container. If you add one of the optional vars below for a Docker
# deployment, add it to that block too or it will be silently ignored.


# ── Required ────────────────────────────────────────────────────────────────

# Signing key for the session JWT (httpOnly cookie). Two rules, both enforced
# at boot: at least 32 characters, and not a recognizable placeholder — values
# containing "change-me", "changeme", "secret", "please-change" or "example"
# are rejected by name, because a deployment left on the shipped placeholder
# lets anyone who can read this repo sign themselves an ADMIN cookie.
# Generate a real one:
#   openssl rand -hex 32
# Rotating this value invalidates every logged-in session immediately.
# The value below is deliberately invalid — the app will refuse to start until
# you replace it.
JWT_SECRET=CHANGE-ME-run-openssl-rand-hex-32

# SQLite connection string. Prisma reads this variable directly, so it is
# required in practice even though apps/api/src/env.ts declares a default —
# that default is never seen by the Prisma client, and an unset DATABASE_URL
# fails at the first query with "Environment variable not found: DATABASE_URL".
# The Docker image bakes in `file:/data/ham.db` (inside the hna-data volume);
# override only if you know why.
#   local dev (path is relative to apps/api/prisma/):  file:./dev.db
DATABASE_URL=file:./dev.db


# ── Optional ────────────────────────────────────────────────────────────────

# Invite-code gate for registration. When non-empty, POST /api/auth/register
# requires a matching `inviteCode` and the web signup form shows the field.
# Empty = open registration — anyone who can reach the app can create an
# account, and the FIRST account ever created becomes ADMIN. On a public URL
# that is a land grab by whoever finds it first, so put a shared join code here
# unless you are deliberately bootstrapping on a closed network.
# NOTE: docker-compose.yml requires this variable to be PRESENT (it may be
# empty). Deleting the line makes `docker compose up` refuse to start.
REGISTRATION_CODE=

# API listen port INSIDE the process/container. Compose maps host 3045 -> 3000;
# changing this without changing the port mapping breaks the healthcheck.
PORT=3000

# development | production | test. Also selects the fallback logo directory
# (see LOGO_DIR) and is set to `production` by docker-compose.yml.
NODE_ENV=development

# Directory of the built SPA the API serves. Empty = the API falls back to
# ../web/dist relative to its working directory. The Docker image sets
# /app/apps/web/dist.
STATIC_DIR=

# Where uploaded college logos are written. Default: /data/logos when
# NODE_ENV=production, otherwise ./data/logos. Must live on a persistent
# volume or logos vanish on the next container recreate.
LOGO_DIR=

# ── Pre-migration snapshots ─────────────────────────────────────────────────
# The container entrypoint snapshots the database (SQLite VACUUM INTO, WAL-safe)
# before `prisma migrate deploy` runs on every start. See README "Backup &
# restore".

# Where snapshots are written. Default: a `backups/` directory beside the
# database file, i.e. /data/backups in Docker — inside the volume, so it
# survives a container recreate.
HNA_BACKUP_DIR=

# How many snapshots to keep; older ones are pruned after a successful run.
# Default 5.
HNA_BACKUP_KEEP=5

# Set to any non-empty value to skip the pre-migration snapshot entirely.
# Only sensible for throwaway/dev containers — leave it unset in production.
HNA_SKIP_PRE_MIGRATE_BACKUP=


# ── Discord (all three optional; env wins over the Admin-page settings) ──────
# When set, these override the values stored in the DB and the Admin UI shows
# an "(env)" marker on the corresponding field. Leaving them unset lets an
# admin configure Discord entirely from the UI, which is the usual path.

# "true" / "false" master switch. Unset = fall back to the DB setting.
DISCORD_ENABLED=

# Bot token from the Discord developer portal. Treat as a secret: anyone with
# it can act as your bot. Requires the MESSAGE CONTENT intent (see README).
DISCORD_BOT_TOKEN=

# Numeric channel id for the chat bridge, reminders, and net notifications.
DISCORD_CHANNEL_ID=
